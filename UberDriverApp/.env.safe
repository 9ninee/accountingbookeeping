# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# Supabase (free tier) — required for cloud sync, auth, and free bank sync
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Plaid — sandbox testing only (fake data). UK production is not free.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# GoCardless Bank Account Data — LEGACY. Closed to new signups since July 2025.
# Only fill these if you already have an account from before then.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Enable Banking (the free bank sync provider) needs NO keys here on purpose:
# its private key lives server-side as Supabase secrets, never in the app.
# Setup guide: docs/FREE_BANK_SYNC.md
